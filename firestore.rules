rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPlatformOperator() {
      return request.auth != null
        && (
          request.auth.uid == "USX9Lc0M6mdRU7QxrMNjJhiV2p42"
          || ("role" in request.auth.token && request.auth.token.role == "platform_operator")
          || ("roles" in request.auth.token && request.auth.token.roles.hasAny(["platform_operator"]))
          || ("platform_operator" in request.auth.token && request.auth.token.platform_operator == true)
        );
    }

    function isPublicSession() {
      return request.auth != null
        && ("publicSession" in request.auth.token && request.auth.token.publicSession == true);
    }

    match /admin/{document=**} {
      allow read, write: if isPlatformOperator();
    }

    function sameTenant(tenantId) {
      return request.auth != null
        && !isPublicSession()
        && request.auth.token.tenantId == tenantId
        && (!exists(/databases/$(database)/documents/tenants/$(tenantId))
          || !('lifecycleState' in get(/databases/$(database)/documents/tenants/$(tenantId)).data)
          || get(/databases/$(database)/documents/tenants/$(tenantId)).data.lifecycleState == 'ACTIVE');
    }

    function tenantRole() {
      return request.auth.token.tenantRole;
    }

    function isTenantOwner(tenantId) {
      return sameTenant(tenantId) && tenantRole() == "OWNER";
    }

    function isTenantOfficeOrOwner(tenantId) {
      return sameTenant(tenantId) && tenantRole() in ["OWNER", "OFFICE_ADMIN"];
    }

    function validTenantRoot(tenantId) {
      return request.resource.data.tenantId == tenantId
        && request.resource.data.brandName is string
        && request.resource.data.avatarName is string;
    }

    function validIntakePacket(tenantId) {
      return request.resource.data.tenantId == tenantId
        && request.resource.data.documentType == "tenant-intake-packet"
        && request.resource.data.packetId is string
        && request.resource.data.intake is map
        && request.resource.data.meta is map;
    }

    function validTenantConfig(tenantId) {
      return request.resource.data.tenantId == tenantId
        && request.resource.data.documentType == "tenant-client-config"
        && request.resource.data.profile is map
        && request.resource.data.branding is map
        && request.resource.data.businessRules is map
        && request.resource.data.channels is map
        && request.resource.data.workflow is map
        && request.resource.data.dashboard is map
        && request.resource.data.meta is map;
    }

    function validRuntimeSummary(tenantId) {
      return request.resource.data.tenantId == tenantId
        && request.resource.data.documentType == "tenant-runtime-summary"
        && request.resource.data.brandName is string
        && request.resource.data.publicAgentName is string
        && request.resource.data.workflow is map
        && request.resource.data.connectivity is map
        && request.resource.data.dashboard is map
        && request.resource.data.updatedAt is string;
    }

    function validSubagent() {
      return request.resource.data.keys().hasAll(["id", "name", "role", "enabled"])
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.role is string
        && request.resource.data.enabled is bool;
    }

    function validAgentSession(data, sessionId) {
      return data.keys().hasAll(["tenantId", "agentId", "sessionId", "ownerUid", "stage", "status", "missingFields"])
        && data.tenantId is string
        && data.agentId is string
        && data.sessionId == sessionId
        && data.ownerUid is string
        && data.stage is string
        && data.status in ["in_progress", "completed"]
        && data.missingFields is list;
    }

    function isAgentSessionOwner(data) {
      return request.auth != null
        && data.ownerUid == request.auth.uid
        && data.tenantId == request.auth.token.tenantId;
    }

    function canWriteOwnAgentSession(data, sessionId) {
      return isAgentSessionOwner(data)
        && validAgentSession(data, sessionId);
    }

    match /agentSessions/{sessionId} {
      allow read: if isPlatformOperator() || isAgentSessionOwner(resource.data);
      allow create: if isPlatformOperator() || canWriteOwnAgentSession(request.resource.data, sessionId);
      allow update: if isPlatformOperator()
        || (
          isAgentSessionOwner(resource.data)
          && canWriteOwnAgentSession(request.resource.data, sessionId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tenantId == resource.data.tenantId
        );
    }

    match /tenants/{tenantId} {
      allow read: if isPlatformOperator() || sameTenant(tenantId);
      allow create, update: if isPlatformOperator() || (sameTenant(tenantId) && validTenantRoot(tenantId));

      match /intakePackets/{packetId} {
        allow read: if isPlatformOperator() || sameTenant(tenantId);
        allow create, update: if isPlatformOperator() || (sameTenant(tenantId) && validIntakePacket(tenantId));
      }

      match /config/{configId} {
        allow read: if isPlatformOperator() || sameTenant(tenantId);
        allow create, update: if isPlatformOperator() || (sameTenant(tenantId) && validTenantConfig(tenantId));
      }

      match /runtimeSummary/{summaryId} {
        allow read: if isPlatformOperator() || sameTenant(tenantId);
        allow create, update: if isPlatformOperator() || (sameTenant(tenantId) && validRuntimeSummary(tenantId));
      }

      match /subagents/{subagentId} {
        allow read: if isPlatformOperator() || sameTenant(tenantId);
        allow create, update: if isPlatformOperator() || (sameTenant(tenantId) && validSubagent());
      }
    }

    match /tenantUsers/{userId} {
      allow read: if isPlatformOperator()
        || (
          request.auth != null
          && sameTenant(resource.data.tenantId)
          && (
            request.auth.token.tenantUserId == userId
            || tenantRole() in ["OWNER", "OFFICE_ADMIN"]
          )
        );
      allow write: if isPlatformOperator()
        || (
          request.auth != null
          && isTenantOwner(request.resource.data.tenantId)
        );
    }

    match /jobAccessLinks/{linkId} {
      allow read, write: if isPlatformOperator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

